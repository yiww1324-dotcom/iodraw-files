{"root":{"data":{"id":"digcwgilyvs0","created":1778554358103,"text":"写教案"},"children":[{"data":{"id":"digd2dhcirs0","created":1778554821681,"text":"为什么写","layout":null},"children":[{"data":{"id":"digd0ag3n600","created":1778554658347,"text":"教什么；怎么教；为什么这样做","layout":null},"children":[]},{"data":{"id":"digd0mz5mt40","created":1778554685621,"text":"分配时间，突出重点，突破难点","layout":null},"children":[]},{"data":{"id":"digd0ysm13k0","created":1778554711346,"text":"上完课就写教案，教师反思、研究、改进","layout":null},"children":[]},{"data":{"id":"digd19ubfkw0","created":1778554735394,"text":"可以临时改课，换人","layout":null},"children":[]}]},{"data":{"id":"digd2i4lhu80","created":1778554831794,"text":"OBE","layout":null},"children":[{"data":{"id":"digd2nodfyw0","created":1778554843874,"text":"表述：课程主题与对应的学习成果","layout":null},"children":[]},{"data":{"id":"digd329ccx40","created":1778554875617,"text":"描述学生可以做到什么","layout":null},"children":[]},{"data":{"id":"digd646oggg0","created":1778555114902,"text":"举一个生活中的例子，讲一个道理；多个例子，细讲、粗讲；社会知识、情感知识","layout":null},"children":[]},{"data":{"id":"digd8auu3gg0","created":1778555286151,"text":"学生为什么学不会；认识的障碍；挑战是什么：过程与能量转化难以联系起来","layout":null},"children":[{"data":{"id":"digd9uslv6o0","created":1778555407916,"text":"如何解决：动画模拟；实验","layout":null},"children":[]}]},{"data":{"id":"digda4ps1nk0","created":1778555429513,"text":"教学活动，对应的学习成果是什么","layout":null},"children":[]},{"data":{"id":"digdcenuvp40","created":1778555607893,"text":"导入什么，探究什么，应用什么","layout":null},"children":[]}]},{"data":{"id":"digddvpyu0g0","created":1778555723390,"text":"教学环节","layout":null},"children":[{"data":{"id":"digddzqakp40","created":1778555732117,"text":"以学生行为为主，成果达成导向（指向能力目标），每个活动都明确对应一个或多个学习成果；评价嵌入全过程","layout":null},"children":[]},{"data":{"id":"digdf32i2k80","created":1778555817750,"text":"不必拘泥于复习-新授-练习-小结，基本开课闲聊，最近发生了什么；稍微宽松，","layout":null},"children":[]},{"data":{"id":"digdfqi46dk0","created":1778555868760,"text":"可根据成果需要设计项目式，问题式，翻转式等流程","layout":null},"children":[]},{"data":{"id":"digdh6qen9c0","created":1778555982454,"text":"让学生知道自己老师是什么，做什么","layout":null},"children":[]}]},{"data":{"id":"digdidlb83c0","created":1778556075747,"text":"学生活动","layout":null},"children":[{"data":{"id":"digdiiit4800","created":1778556086480,"text":"描述学生要干什么，要敲三角铁就去敲","layout":null},"children":[]},{"data":{"id":"digdippd2ao0","created":1778556102114,"text":"不要说学生理解，学生思考；说学生能说出，学生能画出，学生能写出","layout":null},"children":[]}]},{"data":{"id":"digdje2yo000","created":1778556155179,"text":"教师支持","layout":null},"children":[{"data":{"id":"digdjh00mds0","created":1778556161531,"text":"提供模版、问题链、资源包","layout":null},"children":[]},{"data":{"id":"digdjwn5xeo0","created":1778556195582,"text":"组织协作、巡视指导、适时点拨","layout":null},"children":[{"data":{"id":"digdkpbxnm80","created":1778556258030,"text":"给学生分组；给学生设计过程、活动","layout":null},"children":[]}]},{"data":{"id":"digdkxnw7rc0","created":1778556276168,"text":"引导反思与元认知，就只有一块是理论知识","layout":null},"children":[]}]},{"data":{"id":"digdlfw9k6o0","created":1778556315856,"text":"评估","layout":null},"children":[{"data":{"id":"digdlq42y740","created":1778556338096,"text":"判断学生是否朝向成果迈进","layout":null},"children":[]},{"data":{"id":"digdm92u7i00","created":1778556379380,"text":"课堂提问，开放式问题，没有正确答案，什么都可以，用三观去判断","layout":null},"children":[]},{"data":{"id":"digdmesm3eg0","created":1778556391822,"text":"小组展示/白板书写","layout":null},"children":[]},{"data":{"id":"digdml8yie00","created":1778556405871,"text":"快速测验","layout":null},"children":[]},{"data":{"id":"digdmo8i7b40","created":1778556412374,"text":"同伴互评，自评量表","layout":null},"children":[]},{"data":{"id":"digdmux3kwg0","created":1778556426922,"text":"教师观察记录","layout":null},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}