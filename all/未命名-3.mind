{"root":{"data":{"id":"digc4kfwp940","created":1778552172450,"text":"教案"},"children":[{"data":{"id":"digc50y79ao0","created":1778552208385,"text":"教学大纲的一个细节的呈现"},"children":[{"data":{"id":"digc5j77ac80","created":1778552248111,"text":"教案要把教学大纲要突出的点都写出来"},"children":[]},{"data":{"id":"digce3s62yw0","created":1778552919828,"text":"给学生看的"},"children":[]}]},{"data":{"id":"digc6t4xva80","created":1778552348106,"text":"讲课稿"},"children":[{"data":{"id":"digc753ihko0","created":1778552374141,"text":"刚刚当老师的人准备的"},"children":[{"data":{"id":"digc8gifzvk0","created":1778552477353,"text":"一个小时半的课当两个小时"},"children":[]}]},{"data":{"id":"digc9a9o9a80","created":1778552542126,"text":"需要有层级的展开"},"children":[{"data":{"id":"digca02415s0","created":1778552598265,"text":"根据注意力来更改主题"},"children":[]},{"data":{"id":"digcaja8zrs0","created":1778552640116,"text":"每周一见的，要有举例子重新让学生i你；高中老师是每天见的"},"children":[{"data":{"id":"digcb0r2ym80","created":1778552678139,"text":"当你讲座的时候，你特别会控制时长"},"children":[]},{"data":{"id":"digcb91st8w0","created":1778552696201,"text":"当你面对不同情况的时候你特别会调整气氛"},"children":[{"data":{"id":"digcbids4x40","created":1778552716517,"text":"看你对象希望你有什么表达方式（领导（做决策的），我现在遇到这个问题，A方案，什么结果，什么风险，B方案是什么……，你想要哪个）"},"children":[]}]}]}]},{"data":{"id":"digce811egg0","created":1778552929071,"text":"给自己看的"},"children":[]}]},{"data":{"id":"digcefxhefc0","created":1778552946270,"text":"说课稿"},"children":[{"data":{"id":"digcekoaeqo0","created":1778552956598,"text":"给评委听的"},"children":[]},{"data":{"id":"digceu0qpko0","created":1778552976942,"text":"分支主题"},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}