{"root":{"data":{"id":"digcwgilyvs0","created":1778554358103,"text":"为什么写教案"},"children":[{"data":{"id":"digd0ag3n600","created":1778554658347,"text":"教什么；怎么教；为什么这样做"},"children":[]},{"data":{"id":"digd0mz5mt40","created":1778554685621,"text":"分配时间，突出重点，突破难点"},"children":[]},{"data":{"id":"digd0ysm13k0","created":1778554711346,"text":"上完课就写教案，教师反思、研究、改进"},"children":[]},{"data":{"id":"digd19ubfkw0","created":1778554735394,"text":"分支主题"},"children":[]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}