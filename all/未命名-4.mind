{"root":{"data":{"id":"digcwgilyvs0","created":1778554358103,"text":"写教案"},"children":[{"data":{"id":"digd2dhcirs0","created":1778554821681,"text":"为什么写"},"children":[{"data":{"id":"digd0ag3n600","created":1778554658347,"text":"教什么；怎么教；为什么这样做"},"children":[]},{"data":{"id":"digd0mz5mt40","created":1778554685621,"text":"分配时间，突出重点，突破难点"},"children":[]},{"data":{"id":"digd0ysm13k0","created":1778554711346,"text":"上完课就写教案，教师反思、研究、改进"},"children":[]},{"data":{"id":"digd19ubfkw0","created":1778554735394,"text":"可以临时改课，换人"},"children":[]}]},{"data":{"id":"digd2i4lhu80","created":1778554831794,"text":"OBE"},"children":[{"data":{"id":"digd2nodfyw0","created":1778554843874,"text":"表述：课程主题与对应的学习成果"},"children":[]},{"data":{"id":"digd329ccx40","created":1778554875617,"text":"描述学生可以做到什么"},"children":[]},{"data":{"id":"digd646oggg0","created":1778555114902,"text":"举一个生活中的例子，讲一个道理；多个例子，细讲、粗讲；社会知识、情感知识"},"children":[]},{"data":{"id":"digd8auu3gg0","created":1778555286151,"text":"学生为什么学不会；认识的障碍；挑战是什么：过程与能量转化难以联系起来"},"children":[{"data":{"id":"digd9uslv6o0","created":1778555407916,"text":"如何解决：动画模拟；实验"},"children":[]}]},{"data":{"id":"digda4ps1nk0","created":1778555429513,"text":"教学活动，对应的学习成果是什么"},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}